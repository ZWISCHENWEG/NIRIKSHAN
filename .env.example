# ========================================
# PUBLIC CLIENT CONFIG
# ========================================
# Variables prefixed with VITE_ are automatically exposed to the frontend/client.
# These API keys are intended for browser use and are safe to be public.
# DO NOT place your Copernicus username/password here.
# DO NOT place backend-only secrets in VITE_ variables.

# (Optional) Cesium ION access token for 3D terrain and base imagery
VITE_CESIUM_ION_ACCESS_TOKEN=your_cesium_ion_token_here

# (Optional) Carto API key for additional maps
VITE_CARTO_API_KEY=your_carto_api_key_here


# ========================================
# PRIVATE SERVER CONFIG
# ========================================
# These variables are only visible to the backend server.
# Do NOT prefix these with VITE_

# (Optional) Host for Uvicorn to bind to (default: 0.0.0.0)
HOST=0.0.0.0

# (Optional) Port for Uvicorn to listen on (default: 8000)
PORT=8000

# (Optional) Number of Uvicorn worker processes (default: 1)
WORKERS=1

# (Optional) CORS allowed origins (comma separated). Default is "*"
CORS_ORIGINS=*

# (Optional) Data mode: "netcdf" (production) or "demo" (fallback mock data)
OCEAN_DATA_MODE=netcdf

# (Optional) Logging level for backend (e.g. info, debug, warning, error)
LOG_LEVEL=info
